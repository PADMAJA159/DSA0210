import cv2
from google.colab.patches import cv2_imshow

# Step 1: Read the image
img = cv2.imread('/content/OIP2.jpeg')

# Step 2: Define rectangle coordinates (x, y, width, height)
x, y, w, h = 100, 80, 200, 150

# Step 3: Draw rectangle on the image
cv2.rectangle(img, (x, y), (x + w, y + h), (0, 255, 0), 2)

# Step 4: Extract the object (Region of Interest)
roi = img[y:y + h, x:x + w]

# Step 5: Display results
cv2_imshow(img)
cv2_imshow(roi)

# Step 6: Wait and close windows
cv2.waitKey(0)
cv2.destroyAllWindows()
